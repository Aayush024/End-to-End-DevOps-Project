
pipeline {
    agent any

    environment {
        AWS_REGION    = 'ap-south-1'
        AWS_ACCOUNT_ID = '327076610920'
        ECR_REPO      = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/python_web_application"
        IMAGE_TAG     = "build-${BUILD_NUMBER}"
        FULL_IMAGE    = "${ECR_REPO}:${IMAGE_TAG}"
    }

    stages {
        stage('Checkout Application') {
            steps {
                checkout scm
                sh '''
                    echo "Workspace: $WORKSPACE"
                    test -f Jenkins_cicd/Dockerfile
                    test -f Jenkins_cicd/manage.py
                    echo "Django application files found."
                '''
            }
        }

        stage('Check AWS Identity') {
            steps {
                sh '''
                    aws sts get-caller-identity
                    aws ecr describe-repositories \
                      --repository-names python_web_application \
                      --region "$AWS_REGION"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t python_web_application:${IMAGE_TAG} \
                      -f Jenkins_cicd/Dockerfile \
                      Jenkins_cicd
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region "$AWS_REGION" \
                      | docker login \
                        --username AWS \
                        --password-stdin \
                        "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                '''
            }
        }

        stage('Tag and Push Image') {
            steps {
                sh '''
                    docker tag "python_web_application:${IMAGE_TAG}" "$FULL_IMAGE"
                    docker push "$FULL_IMAGE"
                    echo "Successfully pushed: $FULL_IMAGE"
                '''
            }
        }
    }

    post {
        success {
            echo 'Build and ECR image publishing completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the first failed stage in the console log.'
        }
    }
}
